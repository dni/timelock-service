# Bitcoin HD wallet (BIP46) — service's own keys
# Generate with: python -c "from embit import bip39, bip32; seed=bip39.mnemonic_to_seed(bip39.mnemonic()); m=bip32.HDKey.from_seed(seed); print(m.to_string())"
BIP46_XPRV=xprv...
BIP46_XPUB=xpub...

# LNbits (invoice key — not admin key)
LNBITS_URL=https://your-lnbits.com
LNBITS_INVOICE_KEY=<lnbits invoice key>
LNBITS_WEBHOOK_SECRET=<random secret for webhook verification>

# Admin API protection
ADMIN_API_KEY=<random secret>

# Service config
DATABASE_URL=sqlite+aiosqlite:///./data/timelock.db
PREIMAGE_ENCRYPTION_KEY=<64 hex chars — used to encrypt preimage_r at rest>
DEFAULT_FEE_RATE=0.10
INVOICE_EXPIRY_SECONDS=3600
MIN_BOND_SATS=100000
UTXO_MIN_CONFIRMATIONS=1
SERVICE_BASE_URL=https://yourdomain.com
